# Documentation only: applications read environment variables, not this file automatically.
# Set absolute paths for your machine. Keep runtime state outside OneDrive/network shares.
SHIELD_MODE=development
SHIELD_DATA_DIR=/absolute/local/path/shield-api
SHIELD_REGISTRY_FILE=/absolute/path/API-Shield/deploy/registry.local.json
SHIELD_ADMIN_ORIGIN=http://admin.localhost:8081
# Optional; defaults to SHIELD_DATA_DIR/rate.key, created once by the migrate CLI.
# SHIELD_RATE_SECRET_FILE=/absolute/local/path/shield-api/rate.key
# Trusted edge networks are empty for local use. Never use 0.0.0.0/0 or ::/0.
SHIELD_TRUSTED_EDGE_CIDRS=
