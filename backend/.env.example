# --- Database ---
DB_PATH=shield.db
SEED_DEMO_DATA=true

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Bans ---
BAN_DURATION_SECONDS=300

# --- Fake target API (the app being protected) ---
TARGET_API_URL=http://127.0.0.1:8001
GATEWAY_BASE_URL=http://127.0.0.1:8000

# --- Admin login (seeded, not production-grade) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Frontend origins allowed to make credentialed API requests ---
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# --- Gateway key for API requests(Stored in hex must convert to bytes to use)
SHARED_SECRET_KEY= ""
