{
  "name": "api-shield",
  "version": "1.0.0",
  "description": "A local API security gateway with rate limits, temporary bans, request validation, isolated fuzz tests and an administrator panel.",
  "scripts": {
    "dev:ts": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "dev:py": "python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8081 --reload --no-proxy-headers --no-access-log",
    "start:py": "python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8081 --no-proxy-headers --no-access-log",
    "start:gateway": "python -m uvicorn gateway:app --app-dir backend --host 127.0.0.1 --port 8080 --no-proxy-headers --no-access-log",
    "test:e2e": "playwright test",
    "start:demo": "python -m uvicorn demo:app --app-dir backend --host 127.0.0.1 --port 9000 --no-proxy-headers --no-access-log"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vroonster20/API-Shield.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Vroonster20/API-Shield/issues"
  },
  "homepage": "https://github.com/Vroonster20/API-Shield#readme",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "type": "module"
}
